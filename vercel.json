{
  "version": 2,
  "buildCommand": "npx prisma generate && npx tsc --noEmit && npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/subscription-check",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/data-retention-purge",
      "schedule": "0 17 1 * *"
    },
    {
      "path": "/api/cron/incentive-monthly-shadow",
      "schedule": "0 18 1 * *"
    },
    {
      "path": "/api/cron/incentive-auto-finalize",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/invoice-generate",
      "schedule": "0 19 1 * *"
    },
    {
      "path": "/api/cron/heat-forecast-notice",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/ops-digest",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/evening-notices",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/weekly-summary",
      "schedule": "0 15 * * 0"
    }
  ]
}
